# Copy this file to ".env" and fill in the empty values.
# ".env" is gitignored and must NEVER be committed.
#
# This file contains PLACEHOLDER NAMES ONLY. Never put real keys in here.

# --- Secrets (keep these private, never commit them) ---

# API key from https://console.groq.com/keys  (needed for dry runs too)
GROQ_API_KEY=

# Which Groq models to use. These are the defaults, so you normally do not need
# to set them. Change them here if Groq retires a model (a retired model makes
# every call fail with HTTP 404).
# Current model list: https://console.groq.com/docs/models
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# How much the models think before writing: low, medium or high.
# "low" is the default and is the fastest.
GROQ_REASONING_EFFORT=low

# Google OAuth "Desktop app" client id  (see README: how to get the refresh token)
GOOGLE_CLIENT_ID=

# Google OAuth "Desktop app" client secret
GOOGLE_CLIENT_SECRET=

# Long-lived token that lets the script publish without a browser.
# Get it with: npm run get-token -- /path/to/client_secret_123.json
GOOGLE_REFRESH_TOKEN=

# Numeric Blogger blog id (Settings -> Publishing -> Blog ID) or the blog feed URL
BLOGGER_BLOG_ID=

# --- Variables (safe to be public) ---

# Your website, used for the "check your resume ATS score" link every 2nd post.
# Example: https://example.com  (no trailing slash)
WEBSITE_URL=

# "true"  = posts are saved as Blogger drafts (safe default)
# "false" = posts are published live on your blog
DRAFT_MODE=true

# "true"  = generate the post, write it to out/preview.html and stop.
#           No Blogger call and no change to topics.json / state.json.
DRY_RUN=false
